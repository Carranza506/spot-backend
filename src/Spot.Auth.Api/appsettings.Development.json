{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Not set here on purpose — connection strings can carry credentials. Set it with:
    //   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Host=localhost;Database=spot_dev;Username=postgres;Password=..."
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "https://localhost:5443",
    "Audience": "spot-clients",
    "ExpiresInMinutes": 60
    // Set the real keys with (run once per machine, from src/Spot.Auth.Api):
    //   dotnet user-secrets set "Jwt:PrivateKeyPem" "$(cat ../../keys/jwt-private.pem)"
    //   dotnet user-secrets set "Jwt:PublicKeyPem" "$(cat ../../keys/jwt-public.pem)"
    // Never paste key contents directly into this file. See README.md > "RSA keys for JWT".
  }
}
