{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=spot_dev;Username=postgres;Password=YOUR_LOCAL_POSTGRES_PASSWORD"
  },
  "Jwt": {
    "Issuer": "https://api.spot.cr",
    "Audience": "spot-clients",
    "ExpiresInMinutes": 60
    // PrivateKeyPem/PublicKeyPem are NOT set here — even in your own copy of this file. Load
    // them via user-secrets instead (see README.md > "RSA keys for JWT"):
    //   dotnet user-secrets set "Jwt:PrivateKeyPem" "$(cat ../../jwt-private.pem)"
    //   dotnet user-secrets set "Jwt:PublicKeyPem" "$(cat ../../jwt-public.pem)"
  },
  "GoogleAuth": {
    // Not secret (see appsettings.json), but repeated here so this file is a complete,
    // copy-pasteable starting point for Spot.Auth.Api's Development config.
    "AllowedAudiences": [
      "1084984805500-fd0re9f3lkj3p9j7cadmf8rfieim4ji0.apps.googleusercontent.com"
    ]
  }
}
