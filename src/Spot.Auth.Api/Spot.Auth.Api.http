@Spot.Auth.Api_HostAddress = http://localhost:5228

### Register - success
POST {{Spot.Auth.Api_HostAddress}}/auth/register
Content-Type: application/json

{
  "email": "maria.rodriguez@example.com",
  "password": "SuperClave#2026",
  "firstName": "María José",
  "lastName": "Rodríguez Solís",
  "phone": "+506 8888-1234"
}

###

### Register - duplicate email -> 409
POST {{Spot.Auth.Api_HostAddress}}/auth/register
Content-Type: application/json

{
  "email": "maria.rodriguez@example.com",
  "password": "SuperClave#2026",
  "firstName": "María José",
  "lastName": "Rodríguez Solís"
}

###

### Register - malformed body -> 400 (Error schema)
POST {{Spot.Auth.Api_HostAddress}}/auth/register
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "short",
  "firstName": "",
  "lastName": ""
}

###

### Issue a dev token pair (Development only) — also creates matching rows in `users` and `refresh_tokens`.
# @name issueDevToken
POST {{Spot.Auth.Api_HostAddress}}/dev/token?role=CLIENT
Accept: application/json

###
@accessToken = {{issueDevToken.response.body.accessToken}}
@refreshToken = {{issueDevToken.response.body.refreshToken}}

### GET /auth/me
GET {{Spot.Auth.Api_HostAddress}}/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json

### PATCH /auth/me
PATCH {{Spot.Auth.Api_HostAddress}}/auth/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "firstName": "Nuevo Nombre",
  "phone": null
}

### POST /auth/refresh
POST {{Spot.Auth.Api_HostAddress}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### POST /auth/logout
POST {{Spot.Auth.Api_HostAddress}}/auth/logout
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###
