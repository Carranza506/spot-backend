{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://api.spot.cr",
    "Audience": "spot-clients",
    "ExpiresInMinutes": 60
    // PrivateKeyPem and PublicKeyPem are intentionally NOT set here: the private key must
    // never be committed. Provide both via `dotnet user-secrets` in development, or via the
    // Jwt__PrivateKeyPem / Jwt__PublicKeyPem environment variables in production.
    // See README.md > "RSA keys for JWT" for the exact commands.
  },
  "RefreshToken": {
    "ExpirationDays": 30
  },
  "GoogleAuth": {
    // Google OAuth client ids are not secret (they're already public in the corresponding
    // frontend/app), so — unlike the Jwt keys above — this is safe to commit directly. Append
    // Android's/iOS's client ids here when #95/#96 land; no code change needed.
    "AllowedAudiences": [
      "1084984805500-fd0re9f3lkj3p9j7cadmf8rfieim4ji0.apps.googleusercontent.com"
    ]
  }
}
