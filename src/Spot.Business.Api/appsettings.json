{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://api.spot.cr",
    "Audience": "spot-clients"
  },
  "PhotoStorage": {
    "RootPath": "App_Data/photos",
    "PublicBaseUrl": "http://localhost:5195/api/v1/business/media/photos"
  },
  "Stripe": {
    "WebhookSecretFile": "App_Data/stripe/webhook-secret",
    "SuccessUrl": "http://localhost:5173/billing/success?session_id={CHECKOUT_SESSION_ID}",
    "CancelUrl": "http://localhost:5173/billing/cancel"
  }
}
