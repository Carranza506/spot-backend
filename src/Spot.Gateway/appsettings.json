{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/v1/auth/{**catchall}" },
        "Transforms": [ { "PathRemovePrefix": "/api/v1" } ]
      },
      "auth-health-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/health/auth" },
        "Transforms": [ { "PathSet": "/health" } ]
      },
      "business-route": {
        "ClusterId": "business",
        "Match": { "Path": "/api/v1/business/{**catchall}" },
        "Transforms": [ { "PathRemovePrefix": "/api/v1" } ]
      },
      "business-health-route": {
        "ClusterId": "business",
        "Match": { "Path": "/health/business" },
        "Transforms": [ { "PathSet": "/health" } ]
      },
      "booking-route": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/v1/booking/{**catchall}" },
        "Transforms": [ { "PathRemovePrefix": "/api/v1" } ]
      },
      "booking-health-route": {
        "ClusterId": "booking",
        "Match": { "Path": "/health/booking" },
        "Transforms": [ { "PathSet": "/health" } ]
      },
      "aisearch-route": {
        "ClusterId": "aisearch",
        "Match": { "Path": "/api/v1/ai-search/{**catchall}" },
        "Transforms": [ { "PathRemovePrefix": "/api/v1" } ]
      },
      "aisearch-health-route": {
        "ClusterId": "aisearch",
        "Match": { "Path": "/health/ai-search" },
        "Transforms": [ { "PathSet": "/health" } ]
      },
      "notifications-route": {
        "ClusterId": "notifications",
        "Match": { "Path": "/api/v1/notifications/{**catchall}" },
        "Transforms": [ { "PathRemovePrefix": "/api/v1" } ]
      },
      "notifications-health-route": {
        "ClusterId": "notifications",
        "Match": { "Path": "/health/notifications" },
        "Transforms": [ { "PathSet": "/health" } ]
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5228/" }
        }
      },
      "business": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5151/" }
        }
      },
      "booking": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5197/" }
        }
      },
      "aisearch": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5050/" }
        }
      },
      "notifications": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5102/" }
        }
      }
    }
  }
}
