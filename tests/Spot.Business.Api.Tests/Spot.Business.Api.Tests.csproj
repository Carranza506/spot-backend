<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- CategoriesApiFactory runs the real pipeline through WebApplicationFactory<Program>,
         which needs Program.cs's `public partial class Program;` marker plus this package (it
         also pulls in Microsoft.AspNetCore.TestHost transitively). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <!-- Pinned to match Spot.Business.Api's own EF Core version: without this, MSBuild resolves
         the Npgsql provider's older transitive minimum (9.0.1) instead, causing a reference
         version-conflict warning (MSB3277) against Spot.Business.Api.dll's actual (9.0.7)
         dependency — same fix as Spot.Auth.Api.Tests.csproj. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.7" />
    <!-- Repository tests: a real DbContext/SaveChanges round-trip against an ephemeral database,
         not a hand-rolled fake — see CategoryRepositoryTests.cs for why InMemory instead of
         Testcontainers+real Postgres. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.7" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Spot.Business.Api\Spot.Business.Api.csproj" />
  </ItemGroup>

</Project>
