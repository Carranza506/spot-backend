<Project Sdk="Microsoft.NET.Sdk">

  <!-- Helpers shared by the test projects (#164): one definition instead of a copy in each. Not a
       test project itself, so `dotnet test` has nothing to run here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- ILogger<T>, same as the test projects that use it. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
