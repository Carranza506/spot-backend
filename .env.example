# Copy to .env (git-ignored) and ask the team for the real values. Never commit .env.
# Stripe test mode only (#138): the secret key must be a test key (sk_test_...).
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me
# FCM push delivery (#80), optional. FCM_CREDENTIALS_FILE is the path to the service account JSON
# key, kept OUTSIDE the repo (e.g. C:/Users/you/.secrets/spot-fcm.json). Leave both empty to skip.
# FCM_VALIDATE_ONLY=true makes FCM validate messages without delivering them (demos).
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
FCM_VALIDATE_ONLY=false
# Internal service-to-service API key (#79), optional. Path to a file holding the key, kept OUTSIDE
# the repo. Leave empty to use the committed dev-only internal-api-key.placeholder.txt.
INTERNAL_API_KEY_FILE=
